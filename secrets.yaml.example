# Copia este fichero como "secrets.yaml" (junto al YAML) y rellénalo.
# secrets.yaml NO se sube a GitHub (está en .gitignore).

wifi_ssid: "NOMBRE_DE_TU_WIFI"
wifi_password: "CLAVE_DE_TU_WIFI"

# Clave de cifrado de la API y del OTA (32 bytes en base64).
# Genérala con:   openssl rand -base64 32
api_encryption_key: "PEGA_AQUI_LA_CLAVE_GENERADA"

# Clave del hotspot WiFi de emergencia y del QR de la pantalla (mínimo 8 caracteres).
ap_password: "cambia-esta-clave"
